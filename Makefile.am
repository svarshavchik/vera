#
# The .so version is coupled with the package version.

lib_LTLIBRARIES=libvera.la
libvera_la_SOURCES=${COMMON_LIB_SOURCES}
libvera_la_LDFLAGS=-version-info `perl -e 'my @w=split(/\./, "$(VERSION)"); \
	print sprintf("%d%02d%02d", $$w[0], $$w[1], $$w[2] || 0)'`

noinst_LTLIBRARIES=libvera-private.la libvera-all.la

# libvera-private are the functions not used by both vera and vlad binaries,
# and not used by pam_vera.so. This is a static library, no need to make a
# .so out of it.
libvera_private_la_SOURCES=${OTHER_LIB_SOURCES}

# libvera-all contains all source functions, this is used to generate a linkmap
# for vera and vlad binaries. The linkmap is used to figure out into which
# *_LIB_SOURCES each source function belongs.

