EXTRA_vlad_DEPENDENCIES=all.linkmap

# Pseudo target that reads linkmaps from statically-linekd vera and vlad
# binaries, then runs the rebuild-Makefile script that checks if the
# assignment of source files to *_LIB_SOURCES is still correct. If the
# assignment is incorrect, the script will modify the Makefile.am and exit
# with error status. Then, just rerun make to pick things up where they were
# left off.

all.linkmap: rebuild-Makefile vera-all vlad-all pamvera-all
	$(srcdir)/rebuild-Makefile "$(srcdir)" >Makefile.am.new
	touch all.linkmap
	diff -U 3 $(srcdir)/Makefile.am Makefile.am.new && \
		rm -f Makefile.am.new && exit 0; \
		mv -f Makefile.am.new $(srcdir)/Makefile.am && exit 1

# Statically-linked binaries that include all functionality for all cases.
# The linkmap target above uses them to determine the correct assignment
# of source files to *_LIB_SOURCES.

vera_all_SOURCES=vera.C $(VVCONFIG)
vera_all_LDADD=libvera-all.la @YAMLLIBS@
vera_all_LDFLAGS=-static -Wl,-Map=vera-all.linkmap

vlad_all_SOURCES=vlad.C $(VVCONFIG)
vlad_all_LDADD=libvera-all.la @YAMLLIBS@
vlad_all_LDFLAGS=-static -Wl,-Map=vlad-all.linkmap

pamvera_all_SOURCES=pam_vera-all.C
pamvera_all_LDADD=libvera-all.la @YAMLLIBS@ -lpam
pamvera_all_LDFLAGS=-static -Wl,-Map=pamvera-all.linkmap

