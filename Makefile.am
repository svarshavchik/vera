define unitfile_dependency

$(1): $(1).in
	sed 's@~PKGDATADIR~@'"`echo $(pkgdatadir)`"'@;s@~INSTALLCONFIGDIR~@'"`echo $(INSTALLCONFIGDIR)`"'@' <$(srcdir)/$$@.in >$$@

