#
# Read linkmaps from statically-linked "all" binaries. Determine whether
# to place each source file into COMMON_LIB_SOURCES or OTHER_LIB_SOURCES
# and update Makefile.am, if needed.

use IO::File;
use strict;
use warnings;

my $srcdir = shift // ".";

# Makefile.am exports ALL_LIB_SOURCES, read it to make the source map.

my %sourcemap;

foreach my $source_file (split(/\s+/, $ENV{ALL_LIB_SOURCES} // ''))
{
	my $o = $source_file;

	die "Cannot parse source file $o\n"
		unless $o =~ s/\.[Cc]$/.o/;

	$o =~ s@.*/@@;
	$sourcemap{$o} = $source_file;
}

# Read a linkmap file and return a hash keyed by source module.

sub read_linkmap {
	my ($file) = @_;

	my $fh = IO::File->new($file, "r")
	or die "$file: $!\n";

	my %module;

	while (defined(my $l=<$fh>))
	{
		next unless $l =~ /^\.\/\.libs\/[^\(]+\(([^\)]+)/;

		die "Could not find $1\n" unless exists $sourcemap{$1};
		$module{$sourcemap{$1}} = 1;
	}

	return \%module;
}

my $vera=read_linkmap("vera-all.linkmap");
my $vlad=read_linkmap("vlad-all.linkmap");
my $pam_vera=read_linkmap("pamvera-all.linkmap");

# Determine which source files should be in COMMON_LIB_SOURCES vs
# OTHER_LIB_SOURCES.
#
# If a source file is used by just vera, vlad, or pam_vera, it goes into
# OTHER_LIB_SOURCES, otherwise it goes into COMMON_LIB_SOURCES;

my %combined;

$combined{$_}++ for keys %$vera;
$combined{$_}++ for keys %$vlad;
$combined{$_}++ for keys %$pam_vera;

# Sanity check: make sure all source modules were linked into at least one
# of the binaries.

foreach my $srcmodule (values %sourcemap)
{
	die "$srcmodule is not linked into any of vera, vlad, or pam_vera\n"
		unless exists $combined{$srcmodule};
}

delete $combined{$_} for keys %$pam_vera;

# Print out the updated Makefile.am. First, copy everything up until
# ##BEGINGEN, then skip until ##ENDGEN.

my $fh = IO::File->new("$srcdir/Makefile.am", "r")
    or die "Cannot read Makefile.am\n";

while (defined(my $l=<$fh>))
{
	print $l;
	last if $l =~ /^\#\#BEGINGEN/;
}

while (defined(my $l=<$fh>))
{
	last if $l =~ /^\#\#ENDGEN/;
}

# Helper function to print a list of source files, formatted to fit
# in a Makefile.am file.

sub print_sourcelist {

	my $continue = "\\\n";
	my $lastmodule_nopad="";
	my $lastmodule_pad="";

	# We print source file at a time. Every source file except the
	# last one is padded, and a backslash is added, to continue to the
	# next line.
	#
	# So the first order of business, while iterating over the source files
	# is to print the padding+backslash from the previous iteration.

	foreach my $module (sort @_)
	{
		print $lastmodule_pad;

		# If this is going to be the last source file we'll save it,
		# as is, and not add padding+backslash. Otherwise, we'll save
		# it with padding and add a backslash so that the next iteration
		# will print that padding+backslash as its padding.

		$lastmodule_nopad=$module;

		$module = sprintf("%-56s", $module);

		# Convert trailing spaces to tabs, as needed, to keep the lines
		# from getting too long.

		my $tab = "";
		while ($module =~ s/        $//)
		{
			$tab .= "\t";
		}

		if ($module =~ s/ +$//)
		{
			$tab .= "\t";
		}

		print "$continue\t";

		$lastmodule_pad = "$module$tab";
		$continue = "\\\n";
	}
	print $lastmodule_nopad;
	print "\n";
}

my @pamverasources;
my @commonsources;
my @othersources;

foreach my $module (sort keys %$pam_vera)
{
	push @pamverasources, $module;
	delete $combined{$module};
}

foreach my $module (sort keys %combined)
{
	if ($combined{$module} == 1)
	{
		push @othersources, $module;
	}
	else
	{
		push @commonsources, $module;
	}
}

print "\nPAM_VERA_LIB_SOURCES=";
print_sourcelist(@pamverasources);

print "\nCOMMON_LIB_SOURCES=";
print_sourcelist(@commonsources);

print "\nOTHER_LIB_SOURCES=";
print_sourcelist(@othersources);

print "\n##ENDGEN\n";

# Copy the remainder of the Makefile.am
while (defined(my $l=<$fh>))
{
	print $l;
}
